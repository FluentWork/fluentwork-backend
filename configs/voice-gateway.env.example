APP_ENV=development
VOICE_GATEWAY_HTTP_ADDR=:8081

# app-server base URL used for ticket consume (B3).
APP_SERVER_INTERNAL_URL=http://127.0.0.1:8080

# Must match app-server INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=fluentwork-dev-internal-token-change-me!!

# Everything below is optional: each falls back to the compiled-in value shown.
# Optional but not undiscoverable — the gateway's failure mode for an unset knob
# is a session that never answers, not a startup error, which is why the 9/20
# device detour cost a day (see volc.env.example's header).

# --- dev-echo provider (VOICE_GATEWAY_PROVIDER=dev-echo) ---------------------
# Text returned as ServerASRText on every user.speech.end.
# VOICE_DEV_ECHO_TEXT=
# 1/true emits frozen ai.tts.start + audio frames + ai.tts.end. Off by default.
# VOICE_DEV_ECHO_TTS_MOCK=
# DEV_ECHO_TTS_MOCK=                   # either spelling turns it on
# 16 kHz mono s16le PCM or WAV, replayed after user.speech.end.
# VOICE_DEV_ECHO_FIXTURE=

# --- client ASR --------------------------------------------------------------
# 1/true refuses a session whose client never sends ASR.
# VOICE_CLIENT_ASR_REQUIRED=

# --- read timeout ------------------------------------------------------------
# Bounds each WSS read. It only probes half-open connections; it does not reap
# idle users (see 77_ P1-17).
# VOICE_GATEWAY_IDLE_TIMEOUT=2m

# --- B8 stuck rescue ---------------------------------------------------------
# VOICE_RESCUE_ENABLED defaults to the environment's answer rather than to "on":
# production is off, because iOS cannot render a rescue yet and recording one
# nobody saw is data that lies about the user's experience.
# VOICE_RESCUE_ENABLED=1
# The ladder's spacing. VOICE_RESCUE_SYNTH_TIMEOUT must stay under LEVEL1_AFTER;
# Validate refuses a ladder that climbs backwards instead of clamping it.
# VOICE_RESCUE_LEVEL1_AFTER=3s
# VOICE_RESCUE_LEVEL2_AFTER=6s
# VOICE_RESCUE_LEVEL3_AFTER=9s
# VOICE_RESCUE_GEN_TIMEOUT=2500ms
# VOICE_RESCUE_SYNTH_TIMEOUT=1000ms

# --- vendor settings under their gateway-only names --------------------------
# Each is read before the generic VOLC_* name in volc.env.example, so a
# gateway-only deployment can pin a value without touching shared credentials.
# VOICE_GATEWAY_VOLC_SPEECH_API_KEY=
# VOICE_GATEWAY_VOLC_DUPLEX_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# VOICE_GATEWAY_VOLC_DUPLEX_MODEL=1.2.6.1
# VOICE_GATEWAY_VOLC_DUPLEX_VOICE=zh_female_vv_jupiter_bigtts
