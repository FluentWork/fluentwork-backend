APP_ENV=development
HTTP_ADDR=:8080

# Leave empty for the in-memory account store used by ./scripts/dev-up.sh.
# Set this when running ./scripts/dev-up.sh --mysql
# MYSQL_DSN=fw:fw@tcp(127.0.0.1:3306)/fluentwork?parseTime=true&charset=utf8mb4&loc=UTC

# Must be at least 32 characters. Override in production.
AUTH_JWT_SECRET=fluentwork-dev-jwt-secret-change-me!!
AUTH_ACCESS_TTL=2h
AUTH_REFRESH_TTL=720h

# Returned by POST /sessions for the client WSS handshake (B2).
VOICE_GATEWAY_WSS_URL=ws://127.0.0.1:8081/v1/voice
SESSION_TICKET_TTL=60s

# PRD B1: how many user turns a `mini` session may run before the gateway closes
# it (the PRD says 3-5). Absent or 0 falls back to
# session.DefaultMiniSessionTurnLimit; `standard` sessions are never capped.
MINI_SESSION_TURN_LIMIT=5

# Shared secret for app-server ↔ voice-gateway (POST /internal/v1/tickets/consume).
# Must match voice-gateway INTERNAL_API_TOKEN. Override outside development.
INTERNAL_API_TOKEN=fluentwork-dev-internal-token-change-me!!

# Everything below is optional: each falls back to the compiled-in value shown,
# so leaving it commented behaves exactly as it did before the knob existed.
# They are listed because this file is also the manual — dev-up.sh loads it as
# the environment when no real .env exists, and a knob nobody can see is a knob
# nobody can turn.

# --- Tools pointed at this process (cmd/corpus-seed) -------------------------
# APP_BASE_URL=http://127.0.0.1:8080

# --- Review worker -----------------------------------------------------------
# Set to 1 to run the review consumer inside app-server instead of as a separate
# cmd/worker process. Unset derives it: 1 when MYSQL_DSN is empty (the in-memory
# stores cannot be shared across processes), 0 otherwise.
# APP_RUN_REVIEW_WORKER=1
# Names this worker in the job table. cmd/worker defaults to worker-1.
# WORKER_ID=app-server-inproc
# WORKER_POLL_INTERVAL=500ms

# --- E3 drill scheduling ladder (PRD §5.3.2) ---------------------------------
# The PRD ladder is compiled in; these override it without a redeploy. One
# ladder serves both the flash drill's judging and the B7 hit writeback.
# DRILL_PROMOTE_STREAK=3
# DRILL_TRAINING_INTERVAL=24h
# DRILL_AUTOMATED_INTERVAL=168h
# DRILL_AUTOMATED_REVIEW_INTERVAL=720h
# DRILL_FAIL_INTERVAL=1h
# DRILL_ROUND_SIZE=10
# 0 means "no cap": every due 灰 block may enter a round.
# DRILL_DAILY_NEW_BLOCK_LIMIT=0
# How far overdue a block may drift before a round folds it back to "due now"
# (83_ §2.1). 0 disables the sweep.
# DRILL_OVERDUE_WINDOW=72h
# Bounds one flash-drill judgement: the measured maximum, with headroom.
# DRILL_JUDGE_TIMEOUT=6s

# --- Topic cards (PRD §7.8 H1) ----------------------------------------------
# Below this many 语料库 blocks a learner gets no topic cards: there is nothing
# of their own to ground one on.
# TOPIC_MIN_BLOCKS=20
