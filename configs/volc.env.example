# Volcano / Doubao credentials for local smoke only.
# Copy to repo-root `.env.volc.local` (gitignored) and fill values.
# NEVER commit real keys.

# --- 火山方舟（文本 Endpoint）---
# 来源：火山方舟 → API Key 管理
# Dev/POC：项目 default；Prod：项目 FluentWork-Prod（Key/ep 不可混用）
ARK_API_KEY=                 # 本地默认指向 DEV（default 项目）
ARK_API_KEY_DEV=             # default 项目 Key
ARK_API_KEY_PROD=            # FluentWork-Prod 项目 Key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PROJECT=default

# --- Dev / POC Endpoint（项目 default）---
ARK_EP_REVIEW_REFINE=ep-20260830204651-pffhf
ARK_EP_DAILY_READ=ep-20260830204818-8kdfr
ARK_EP_TOPIC_CARD=ep-20260830204912-wtjw9
ARK_EP_HIT_MATCH=ep-20260830205333-prddb
ARK_EP_DRILL_JUDGE=ep-20260830205423-xg4pd
ARK_EP_TEXT_DEGRADE=ep-20260830205520-d9d8n

# --- Prod Endpoint（项目 FluentWork-Prod；上线用，勿与 default Key 混用）---
# ARK_EP_REVIEW_REFINE=ep-20260830211617-26d79
# ARK_EP_DAILY_READ=ep-20260830211650-vkdj2
# ARK_EP_TOPIC_CARD=ep-20260830211715-q79x9
