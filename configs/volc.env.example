# Volcano / Doubao credentials for local smoke only.
# Copy to repo-root `.env.volc.local` (gitignored) and fill values.
# NEVER commit real keys.

# --- 火山方舟（文本 Endpoint）---
# 来源：火山方舟 → API Key 管理
# Dev / Prod 分项目各一把；本地默认用 Dev
ARK_API_KEY=                 # 本地 Dev：default 项目 Key
ARK_API_KEY_DEV=             # 可与 ARK_API_KEY 相同（default）
ARK_API_KEY_PROD=            # 上线前在 FluentWork-Prod 创建后填写
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PROJECT=default          # Dev/POC 使用 default；Prod 另行项目
ARK_EP_REVIEW_REFINE=ep-20260830204651-pffhf
ARK_EP_DAILY_READ=ep-20260830204818-8kdfr
ARK_EP_TOPIC_CARD=ep-20260830204912-wtjw9
ARK_EP_HIT_MATCH=ep-20260830205333-prddb
ARK_EP_DRILL_JUDGE=ep-20260830205423-xg4pd
ARK_EP_TEXT_DEGRADE=ep-20260830205520-d9c8n

# --- 豆包语音（新版：仅 API Key，不再需要 AppID / Access Token）---
# 来源：豆包语音 → API Key 管理
# 请求头：X-Api-Key（旧版 X-Api-App-Id + X-Api-Access-Key 已废弃于本项目口径）
VOLC_SPEECH_API_KEY=

# ResourceId：区分端到端 / ASR / TTS（以控制台「开通服务」为准）
VOLC_SPEECH_RESOURCE_TTS=seed-tts-2.0
VOLC_SPEECH_RESOURCE_ASR=
VOLC_SPEECH_RESOURCE_RTC=
