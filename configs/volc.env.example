# --- 豆包语音（新版：仅 API Key；≠ 方舟 Key）---
# 控制台 Key 名（真值只写 .env.volc.local）：
#   Dev/default：api-key-20260830213945
#   Prod：api-key-20260830213853
VOLC_SPEECH_API_KEY=         # 本地默认指向 Dev
VOLC_SPEECH_API_KEY_DEV=
VOLC_SPEECH_API_KEY_PROD=
# B14 POC：默认同 Dev 语音 Key；实时链路用全双工 duplex（JSON WSS，仅 X-Api-Key）
VOLC_POC_API_KEY=
# VOLC_POC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# VOLC_DUPLEX_MODEL=1.2.6.0
# VOLC_DUPLEX_VOICE=zh_female_vv_jupiter_bigtts
# VOLC_POC_LIVE_T9=1   # 可选：跑 live session.update 延迟探针（仍非 B12 冻结证据）
# 可选：仅当 TTS/ASR 子接口文档仍要求 X-Api-Resource-Id（产品级 SKU）时再填
# VOLC_SPEECH_RESOURCE_TTS=seed-tts-2.0
