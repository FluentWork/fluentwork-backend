#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ -x "$ROOT/scripts/ocr-local-review.sh" ]]; then
  exec "$ROOT/scripts/ocr-local-review.sh"
fi
if [[ -x "$ROOT/Scripts/ocr-local-review.sh" ]]; then
  exec "$ROOT/Scripts/ocr-local-review.sh"
fi

echo "error: ocr-local-review.sh not found under scripts/ or Scripts/" >&2
exit 1

