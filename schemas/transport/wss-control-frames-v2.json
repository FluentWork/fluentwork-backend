{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluentwork.app/schemas/transport/wss-control-frames-v2.json",
  "title": "FluentWork WSS control frames v2",
  "description": "JSON control frames for voice-gateway <-> iOS (WSS V2). ai.tts.audio is a WebSocket binary message (UInt32 BE seq + payload), not a JSON control frame.",
  "oneOf": [
    { "$ref": "#/$defs/auth" },
    { "$ref": "#/$defs/sessionReady" },
    { "$ref": "#/$defs/sessionStart" },
    { "$ref": "#/$defs/userSpeechStart" },
    { "$ref": "#/$defs/userSpeechEnd" },
    { "$ref": "#/$defs/clientTurnAbort" },
    { "$ref": "#/$defs/clientRescueRequest" },
    { "$ref": "#/$defs/aiTextDelta" },
    { "$ref": "#/$defs/aiAudioChunk" },
    { "$ref": "#/$defs/aiTTSStart" },
    { "$ref": "#/$defs/aiTTSEnd" },
    { "$ref": "#/$defs/aiRescueLadder" },
    { "$ref": "#/$defs/aiTurnEnd" },
    { "$ref": "#/$defs/interrupt" },
    { "$ref": "#/$defs/feedbackBadge" },
    { "$ref": "#/$defs/sessionEnd" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "auth": {
      "type": "object",
      "required": ["type", "ticket"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "auth" },
        "ticket": { "type": "string", "minLength": 1 }
      }
    },
    "sessionReady": {
      "type": "object",
      "required": ["type", "session_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "session.ready" },
        "session_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string" }
      }
    },
    "sessionStart": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "session.start" },
        "material_id": { "type": "string" },
        "scene_type": { "type": "string" },
        "voice": { "type": "string" }
      }
    },
    "userSpeechStart": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "user.speech.start" }
      }
    },
    "userSpeechEnd": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "user.speech.end" },
        "text": { "type": "string", "maxLength": 4096 },
        "turn_id": { "type": "string", "minLength": 1 }
      }
    },
    "clientTurnAbort": {
      "description": "I20: client aborts an in-progress recording turn. Outcome is timeout / user_abandoned / error; never ok. Not B15's post-speech-end 70s collectTurn timeout. Session stays alive; gateway must not start collectTurn.",
      "type": "object",
      "required": ["type", "outcome"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "client.turn.abort" },
        "turn_id": { "type": "string", "minLength": 1 },
        "outcome": {
          "type": "string",
          "enum": ["timeout", "user_abandoned", "error"]
        }
      }
    },
    "clientRescueRequest": {
      "description": "B8: the user asks for a rescue rung themselves instead of waiting for the silence detector. Carries no level on purpose — the ladder's position belongs to the gateway, and a client that could name one could ask for the worked example on its first tap. The rung that answers it shares the automatic ladder's position, so a tap advances that ladder rather than opening a second one.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "client.rescue.request" }
      }
    },
    "aiTextDelta": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.text.delta" },
        "text": { "type": "string" },
        "turn_id": { "type": "string" },
        "server_ts_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "aiAudioChunk": {
      "type": "object",
      "required": ["type", "seq"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.audio.chunk" },
        "seq": { "type": "integer", "minimum": 0 },
        "turn_id": { "type": "string" }
      }
    },
    "aiTTSStart": {
      "type": "object",
      "required": ["type", "turn_id", "voice_id", "sample_rate", "codec"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.tts.start" },
        "turn_id": { "type": "string", "minLength": 1 },
        "voice_id": { "type": "string", "minLength": 1 },
        "sample_rate": { "type": "integer", "enum": [16000, 24000, 48000] },
        "codec": { "type": "string", "enum": ["opus", "pcm"] },
        "turn_ref": { "type": "integer", "minimum": 1, "description": "Optional. Selects the downlink binary audio layout for this turn: present -> h8 (8-byte header, carries turn_ref), absent -> h4 (4-byte header). This field is the layout switch, which is what makes the change rollback-able without a handshake. See schemas/transport/wss-binary-audio-frames-v1.json (layout_selection)." }
      }
    },
    "aiTTSAudio": {
      "description": "Not a JSON control frame. WebSocket binary: 4-byte big-endian seq + non-empty payload. type constant is ai.tts.audio for logs only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.tts.audio" }
      }
    },
    "aiTTSEnd": {
      "type": "object",
      "required": ["type", "turn_id", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.tts.end" },
        "turn_id": { "type": "string", "minLength": 1 },
        "completion_status": { "type": "string", "enum": ["ok", "interrupted", "error"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "turn_ref": { "type": "integer", "minimum": 1, "description": "Optional. Closes the client's turn_ref -> turn_id mapping entry opened by the matching ai.tts.start, so the mapping does not grow for the life of the socket. Present exactly when the matching ai.tts.start carried it." }
      }
    },
    "aiRescueLadder": {
      "description": "B8: one rung of the rescue ladder, sent when the silence detector fires or when the user asked for it (client.rescue.request). Level is the ladder's position — 1 sentence skeleton, 2 Chinese intent hint, 3 complete example — and it only ever advances, because the PRD's ladder climbs one rung at a time. The rung is spoken: audio arrives on this frame's turn_id as an ai.tts.start / ai.tts.audio / ai.tts.end stream, so audio_url and duration_ms are reserved and always empty. The client is not required to display the text; the hint is delivered by voice so it does not take a UI element or leave the conversation flow.",
      "type": "object",
      "required": ["type", "turn_id", "level", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.rescue.ladder" },
        "turn_id": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "text": { "type": "string" },
        "audio_url": { "type": "string", "description": "Reserved. The spoken rung arrives as ai.tts.* on turn_id; this field is never set." },
        "duration_ms": { "type": "integer", "minimum": 0, "description": "Reserved. The client gets the duration from ai.tts.end." },
        "ts": { "type": "integer", "minimum": 0 }
      }
    },
    "aiTurnEnd": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ai.turn.end" },
        "turn_id": { "type": "string" },
        "outcome": { "type": "string", "enum": ["ok", "partial", "timeout", "error"] },
        "log_id": { "type": "string" }
      }
    },
    "interrupt": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "interrupt" },
        "max_seq": { "type": "integer", "minimum": 0 }
      }
    },
    "feedbackBadge": {
      "type": "object",
      "required": ["type", "badge"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "feedback.badge" },
        "badge": { "type": "string", "minLength": 1 },
        "phrase_block_id": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "enum": ["soft", "highlight", "celebrate"] },
        "session_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "dedupe_key": { "type": "string", "minLength": 1 }
      }
    },
    "sessionEnd": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "session.end" },
        "reason": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ping": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ping" },
        "ts": { "type": "integer" }
      }
    },
    "pong": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "pong" },
        "ts": { "type": "integer" }
      }
    }
  }
}
